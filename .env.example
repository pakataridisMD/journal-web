# Copy to .env.local for local development. Never commit real keys.

# Convex: `npx convex dev` writes these two for you.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk: Dashboard → Configure → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The site's public address, used in the sitemap, citations and link previews.
# On Vercel it falls back to the production domain when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# These two are set on the Convex deployment, not here:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev
#   npx convex env set JOURNAL_ADMIN_EMAILS you@example.org
